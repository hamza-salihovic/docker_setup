// Example: C/C++ project on devbase.
// Copy to <your-project>/.devcontainer/devcontainer.json and adjust "name".
{
	"name": "my-cpp-project",
	"image": "devbase:1.0.0",
	"remoteUser": "dev",
	"updateRemoteUserUID": true,
	"postCreateCommand": "devbase-init",
	"containerEnv": {
		"SSH_AUTH_SOCK": "/run/host-services/ssh-auth.sock",
		"ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
		"ANTHROPIC_BASE_URL": "${localEnv:ANTHROPIC_BASE_URL}",
		"BRAVE_API_KEY": "${localEnv:BRAVE_API_KEY}",
		"GEMINI_API_KEY": "${localEnv:GEMINI_API_KEY}",
		"KILO_API_KEY": "${localEnv:KILO_API_KEY}",
		"ONEPROVIDER_API_KEY": "${localEnv:ONEPROVIDER_API_KEY}",
		"OPENCLAW_GATEWAY_TOKEN": "${localEnv:OPENCLAW_GATEWAY_TOKEN}",
		"WAKATIME_API_KEY": "${localEnv:WAKATIME_API_KEY}",
		"ZED_OPEN_AI_COMPATIBLE_EDIT_PREDICTION_API_KEY": "${localEnv:ZED_OPEN_AI_COMPATIBLE_EDIT_PREDICTION_API_KEY}"
	},
	"mounts": [
		// Core volumes — always keep all five.
		"source=devbase-commandhistory,target=/commandhistory,type=volume",
		"source=devbase-config,target=/home/dev/.devbase,type=volume",
		"source=devbase-vscode-server,target=/home/dev/.vscode-server,type=volume",
		"source=devbase-data,target=/home/dev/data,type=volume",
		"source=devbase-omp,target=/home/dev/.omp,type=volume",
		// OrbStack / Docker Desktop host ssh-agent (1Password).
		"source=/run/host-services/ssh-auth.sock,target=/run/host-services/ssh-auth.sock,type=bind"
	],
	"customizations": {
		"vscode": {
			// Project-specific extensions go above.
			"extensions": [
				"ms-vscode.cpptools",
				"ms-vscode.cpptools-extension-pack",
				"llvm-vs-code-extensions.vscode-clangd",
				"ms-vscode.makefile-tools"
			],
			"settings": {
				// clangd requires a compile_commands.json file.
				// Generate it by running: bear -- make
				"C_Cpp.intelliSenseEngine": "disabled",
				"clangd.arguments": [
					"--background-index",
					"--clang-tidy",
					"--header-insertion=iwyu"
				],
				"files.associations": {
					"*.h": "c",
					"*.hpp": "cpp",
					"*.cc": "cpp",
					"*.cxx": "cpp"
				},
				// Dialed back to c++98 to match strict campus grading requirements
				"C_Cpp.default.cppStandard": "c++98",
				"C_Cpp.default.cStandard": "c99"
			}
		}
	}
}
